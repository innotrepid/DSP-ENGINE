# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare source files
*.c     text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.cmake text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.ico   binary
*.so    binary
*.dll   binary
*.dylib binary
*.a     binary
*.lib   binary
*.exe   binary
